[TEMPLATE]
# Mugil IDE — token-efficient AI IDE
#
# Keys can be set here, or saved once via `mugil-ide login` (preferred — stored
# safely in the user env file, never echoed/committed).
#
# OpenRouter is the primary provider; without any key the CLI runs in mock mode.
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI / Anthropic — used when OPENROUTER_API_KEY is absent (auto-detected).
# Set AI_PROVIDER below to force one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Force the completion provider: openrouter | openai | anthropic (default: auto)
AI_PROVIDER=

# User env file where `mugil-ide login` stores keys (owner-only permissions)
MUGIL_IDE_ENV_FILE=~/.config/mugil-ide/.env

# Redis URL (optional — falls back to in-memory cache when absent/unreachable)
REDIS_URL=redis://localhost:6379

# Redis Cluster: comma-separated node URLs (optional — used when REDIS_URL is unset;
# multiple URLs switch the cache backend to a cluster client)
REDIS_CLUSTER_URLS=redis://node1:6379,redis://node2:6379,redis://node3:6379

NODE_ENV=development
AI_DEBUG=false

# Token budget for a single prompt (chars/4 heuristic or cl100k tokens)
TOKEN_BUDGET=10000
CACHE_TTL=3600

# Comma-separated model ladders used by the handoff manager (cheap -> smart order)
OPENROUTER_MODELS=openrouter/auto,mistralai/mistral-small,anthropic/claude-3.5-sonnet
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1
ANTHROPIC_MODELS=claude-3-5-haiku,claude-3-5-sonnet,claude-sonnet-4

# Custom OpenAI-/Anthropic-compatible endpoints (chat completions / Messages API)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional OpenAI-compatible embeddings endpoint for semantic cache (falls back to lexical similarity)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
