# Mugil IDE — token-efficient AI IDE
#
# Keys can be set here, or saved once via the web UI's Accounts & Keys modal
# (stored safely in the user env file, never echoed/committed).
#
# OpenRouter is the primary provider; without any key the engine runs in mock mode.
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI / Anthropic — used when OPENROUTER_API_KEY is absent (auto-detected).
# Set AI_PROVIDER below to force one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Force the completion provider: openrouter | openai | anthropic (default: auto)
AI_PROVIDER=

# User env file where the Accounts modal stores keys (owner-only permissions)
MUGIL_IDE_ENV_FILE=~/.config/mugil-ide/.env

# Cache + sessions directory (file cache, saved conversations)
MUGIL_IDE_CACHE_DIR=~/.cache/mugil-ide

# Persisted model selection (written by the web UI model selector)
MUGIL_IDE_MODEL=

# Auto Update Manager registry URL / local rules override directory
MUGIL_IDE_MODULES_REGISTRY=
MUGIL_IDE_MODULES_DIR=

# Redis URL (optional — falls back to file cache when absent/unreachable)
REDIS_URL=redis://localhost:6379

# Redis Cluster: comma-separated node URLs (optional — used when REDIS_URL is unset;
# multiple URLs switch the cache backend to a cluster client)
REDIS_CLUSTER_URLS=redis://node1:6379,redis://node2:6379,redis://node3:6379

NODE_ENV=development
AI_DEBUG=false

# Token budget for a single prompt (chars/4 heuristic or cl100k tokens)
TOKEN_BUDGET=10000
CACHE_TTL=3600

# Comma-separated model ladders used by the handoff manager (cheap -> smart order)
OPENROUTER_MODELS=openrouter/auto,mistralai/mistral-small,anthropic/claude-3.5-sonnet
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1
ANTHROPIC_MODELS=claude-3-5-haiku,claude-3-5-sonnet,claude-sonnet-4

# Custom OpenAI-/Anthropic-compatible endpoints (chat completions / Messages API)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional OpenAI-compatible embeddings endpoint for semantic cache (falls back to lexical similarity)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Per-mode tool permission overrides (JSON: {"act":{"write_file":"deny"}},
# values: allow | ask | deny) — applies on top of the mode defaults:
# plan denies writes/commands, act asks for approval
MUGIL_IDE_TOOL_PERMISSIONS=

# Run `tsc --noEmit` after tool writes/edits and feed errors back to the model
# so it self-corrects before expensive test runs (default: off)
MUGIL_IDE_TOOL_DIAGNOSTICS=0

# MCP servers to consume as agent tools (JSON array). Each entry is either
# stdio: {"name", "command", "args"?, "env"?} or HTTP: {"name", "url", "headers"?}.
# Tools appear as mcp__<name>__<tool> and are ask-gated in act / denied in plan.
MUGIL_IDE_MCP_SERVERS=
# Optional JSON file with the same array shape (env value wins on name conflicts)
MUGIL_IDE_MCP_CONFIG=

# Enable the websearch agent tool (delegates to Exa AI's hosted MCP server at
# https://mcp.exa.ai/mcp — no API key needed for casual use)
MUGIL_IDE_ENABLE_EXA=0
# Optional Exa API key to lift rate limits (sent as x-api-key header)
MUGIL_IDE_EXA_API_KEY=

# Webhook endpoints notified on pipeline events (JSON array). Events:
# turn.started, tool.executed, turn.completed, turn.error (absent events = all).
# Delivery is fire-and-forget with a 5s timeout — it never slows the agent loop.
MUGIL_IDE_WEBHOOKS=
# Optional JSON file with the same array shape (env value wins on URL conflicts)
MUGIL_IDE_WEBHOOKS_CONFIG=

# Enable the lsp agent tool (goToDefinition / findReferences / hover). Requires
# a language server on PATH: npm i -g typescript-language-server
MUGIL_IDE_ENABLE_LSP=0

# PTY backend for the shell pane: "auto" (node-pty, fallback to child_process)
# or "child" (always plain child_process — no real TTY, but clean teardown on
# Windows where node-pty's kill() leaks its named-pipe sockets)
MUGIL_IDE_PTY_BACKEND=auto

# Mid-task question-picker timeout in ms (default 120000). Mainly a test hook
# for the browser smoke (`npm run smoke:question-picker`) — the tool loop never
# hangs on an unanswered picker.
MUGIL_IDE_QUESTION_TIMEOUT_MS=120000
