{
  "name": "mugil-ide",
  "version": "0.1.12",
  "private": true,
  "description": "Token-efficient Mugil IDE — core engine + web IDE",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && node packages/cli/dist/index.js",
    "start": "node packages/cli/dist/index.js",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "update:check": "node packages/cli/dist/index.js update --check",
    "update:watch": "node packages/cli/dist/index.js update --watch",
    "smoke:question-picker": "npm run smoke:question-picker -w mugil-ide",
    "smoke:diff-viewer": "npm run smoke:diff-viewer -w mugil-ide",
    "mcp": "node packages/mcp/dist/stdio.js",
    "pack": "npm run build && node scripts/pack-all.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
