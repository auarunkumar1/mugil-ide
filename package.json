{
  "name": "mugil-ide",
  "version": "0.6.0",
  "private": true,
  "description": "Open-source, token-efficient AI coding agent and local-first browser IDE with llama.cpp, Ollama, LM Studio, MCP, and local-only secrets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/auarunkumar1/mugil-ide.git"
  },
  "homepage": "https://github.com/auarunkumar1/mugil-ide#readme",
  "bugs": {
    "url": "https://github.com/auarunkumar1/mugil-ide/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && node packages/cli/dist/index.js",
    "start": "node packages/cli/dist/index.js",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update:check": "node packages/cli/dist/index.js update --check",
    "update:watch": "node packages/cli/dist/index.js update --watch",
    "smoke:question-picker": "npm run smoke:question-picker -w mugil-ide",
    "smoke:diff-viewer": "npm run smoke:diff-viewer -w mugil-ide",
    "mcp": "node packages/mcp/dist/stdio.js",
    "pack": "npm run build && node scripts/pack-all.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
