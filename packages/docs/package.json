{
  "name": "@mugil-ide/docs",
  "version": "1.0.0",
  "description": "MD Generator — automated, periodic markdown documentation for a project",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "prepack": "npm run build",
    "prebuild": "npm run build -w @mugil-ide/core",
    "pretypecheck": "npm run build -w @mugil-ide/core",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@mugil-ide/core": "1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
