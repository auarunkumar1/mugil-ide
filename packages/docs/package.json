{
  "name": "@mugil-ide/docs",
  "version": "0.1.4",
  "description": "MD Generator — automated, periodic markdown documentation for a project",
  "keywords": [
    "documentation",
    "markdown",
    "docs",
    "generator",
    "ai",
    "mugil-ide"
  ],
  "author": "Mugil IDE Contributors",
  "homepage": "https://github.com/auarunkumar1/mugil-ide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auarunkumar1/mugil-ide.git"
  },
  "bugs": {
    "url": "https://github.com/auarunkumar1/mugil-ide/issues"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "prebuild": "npm run build -w @mugil-ide/core",
    "pretypecheck": "npm run build -w @mugil-ide/core",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@mugil-ide/core": "0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
