{
  "name": "@mugil-ide/mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server exposing the Mugil IDE engine modules as tools",
  "bin": {
    "mugil-ide-mcp": "dist/stdio.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": ["dist"],
  "scripts": {
    "prepack": "npm run build",
    "prebuild": "npm run build -w @mugil-ide/core",
    "pretypecheck": "npm run build -w @mugil-ide/core",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "@mugil-ide/core": "1.0.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
