{
  "version": "1.0.0",
  "rules": [
    {
      "provider": "anthropic",
      "label": "anthropic:system-tag",
      "pattern": "\\s*<\\/?system>\\s*",
      "flags": "gi"
    },
    {
      "provider": "anthropic",
      "label": "anthropic:human-assistant-markers",
      "pattern": "\\s*Human:\\s*",
      "flags": "gi"
    },
    {
      "provider": "anthropic",
      "label": "anthropic:identity-preamble",
      "pattern": "\\s*you are claude(, an? |,)?[^.\\n]*\\.?",
      "flags": "gi"
    },
    {
      "provider": "openai",
      "label": "openai:identity-preamble",
      "pattern": "\\s*(as an? ai (language model|assistant|chatbot)|as a language model|you are (chatgpt|gpt-|openai)[^.\\n]*\\.?)[^.\\n]*\\.?",
      "flags": "gi"
    },
    {
      "provider": "openai",
      "label": "openai:refusal-boilerplate",
      "pattern": "\\s*i'?m (just )?an ai( (language model|assistant|chatbot))?[,;][^.\\n]*\\.?",
      "flags": "gi"
    },
    {
      "provider": "generic",
      "label": "generic:gratitude-closer",
      "pattern": "\\s*(thank you (so much |very much )?(for|in advance)|thanks (for|in advance)|appreciate (your|the) help|much appreciated)[^.\\n]*\\.?",
      "flags": "gi"
    },
    {
      "provider": "generic",
      "label": "generic:request-closer",
      "pattern": "\\s*(please (let me know|feel free to|don'?t hesitate to|reach out)|looking forward to (your|hearing))[^.\\n]*\\.?",
      "flags": "gi"
    },
    {
      "provider": "generic",
      "label": "generic:disclaimer",
      "pattern": "\\s*(i am (not|just) (an? )?(ai|bot|assistant)|this is (an? )?automated)[^.\\n]*\\.?",
      "flags": "gi"
    },
    {
      "provider": "generic",
      "label": "generic:ellipsis",
      "pattern": "\\.{4,}",
      "flags": "g"
    }
  ],
  "code": {
    "generatedHeader": {
      "pattern": "^\\s*(?:\\/\\/|#|--|;|\\/\\*)\\s*(?:auto[- ]?generated|generated by|created by|written by|produced by)\\b[^\\n]*(\\n\\s*(?:\\/\\/|#|--|;|\\/\\*|\\*)[^\\n]*)*",
      "flags": "i"
    },
    "generatedCommentLine": {
      "pattern": "^\\s*(?:\\/\\/|#|--|;)\\s*(?:this (?:file|code|function|class) (?:was )?(?:generated|created|written)|generated|created|written|powered)\\s+by\\s+(?:copilot|chatgpt|claude|gemini|openai|bard|an?\\s+ai)[^\\n]*\\n?",
      "flags": "gim"
    },
    "invisibleWatermark": {
      "pattern": "[\\u200B-\\u200D\\u2060\\uFEFF]",
      "flags": "g"
    }
  }
}
