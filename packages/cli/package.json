{
  "name": "mugil-ide",
  "version": "0.1.0",
  "type": "module",
  "description": "Token-efficient Mugil IDE web IDE server (browser xterm.js UI + PTY + headless one-shot mode)",
  "keywords": ["ai", "ide", "agent", "coding-assistant", "terminal", "xterm", "token-efficient", "mcp", "mugil-ide"],
  "author": "Mugil IDE Contributors",
  "homepage": "https://github.com/auarunkumar1/mugil-ide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auarunkumar1/mugil-ide.git"
  },
  "bugs": {
    "url": "https://github.com/auarunkumar1/mugil-ide/issues"
  },
  "license": "MIT",
  "bin": {
    "mugil-ide": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "prebuild": "npm run build -w @mugil-ide/core && npm run build -w @mugil-ide/docs",
    "pretypecheck": "npm run build -w @mugil-ide/core && npm run build -w @mugil-ide/docs",
    "build": "tsc -p tsconfig.json && node scripts/vendor-xterm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "smoke:question-picker": "npm run build && node scripts/smoke-question-picker.mjs",
    "smoke:diff-viewer": "npm run build && node scripts/smoke-diff-viewer.mjs"
  },
  "dependencies": {
    "@mugil-ide/core": "0.1.0",
    "@mugil-ide/docs": "0.1.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.2"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  }
}
